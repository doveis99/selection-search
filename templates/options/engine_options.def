<td class="engine-options">

    <a href="#" class="engine-opts-link" data-i18n-title="engine_opt_title">&nbsp;</a>

    <div class="engine-options-popup dropdown-popup">
        <a href="#" class="close-popup" data-i18n-title="close"></a>
        {{ if(!it.en.is_submenu && !it.en.is_separator) { }}
            <div class="opt-group">
                <label class="opt-check">
                    <input class="post" id="engine-opt-post-{{=it.id}}" type="checkbox">
                    <span data-i18n="engine_opt_post"></span>
                </label>
            </div>
        {{ } }}

        <div class="opt-group">
            <p class="opt-title" data-i18n="engine_opt_show_in"></p>
            <label class="opt-check">
                <input type="checkbox" class="hide_in_popup" id="engine-opt-popup-{{=it.id}}">
                <span data-i18n="engine_opt_show_popup"></span>
            </label>
            <label class="opt-check">
                <input type="checkbox" class="hide_in_ctx" id="engine-opt-ctx-{{=it.id}}">
                <span data-i18n="engine_opt_show_ctx"></span>
            </label>
            <label class="opt-check">
                <input type="checkbox" class="hide_in_toolbar" id="engine-opt-toolbar-{{=it.id}}">
                <span data-i18n="engine_opt_show_toolbar"></span>
            </label>
            <p class="opt-desc" data-i18n="engine_opt_show_in_note"></p>
        </div>

        {{ if(!it.en.is_submenu && !it.en.is_separator) { }}
            <div class="opt-group">
                <label class="opt-check">
                    <input class="hide_on_click" id="engine-opt-hide-on-click-{{=it.id}}" type="checkbox">
                    <span data-i18n="engine_opt_hide_on_click"></span>
                </label>
                <p class="opt-desc" data-i18n="engine_opt_hide_on_click_desc"></p>
            </div>
        {{ } }}

        {{? it.en.is_submenu }}
            <div class="opt-group">
                <label class="opt-check">
                    <input class="openall" id="engine-opt-openall-{{=it.id}}" type="checkbox" />
                    <span data-i18n="engine_opt_openall"></span>
                </label>
                <p class="opt-desc" data-i18n="engine_opt_openall_desc"></p>

                <div class="hide_menu_wrap opt-group indent">
                    <label class="opt-check">
                        <input class="hidemenu" id="engine-opt-hidemenu-{{=it.id}}" type="checkbox" />
                        <span data-i18n="engine_opt_hidemenu"></span>
                    </label>
                    <p class="opt-desc" data-i18n="engine_opt_hidemenu_desc"></p>

                    <label class="opt-check">
                        <input class="hide_on_click" id="engine-opt-hide-on-click-{{=it.id}}" type="checkbox" />
                        <span data-i18n="engine_opt_hide_on_click"></span>
                    </label>
                    <p class="opt-desc" data-i18n="engine_opt_hide_on_click_submenu_desc"></p>

                    <label class="opt-check">
                        <input class="openall_aux" id="engine-opt-open-all-aux-{{=it.id}}" type="checkbox" />
                        <span data-i18n="engine_opt_openall_aux"></span>
                    </label>
                    <p class="opt-desc" data-i18n="engine_opt_openall_aux_desc"></p>
                </div>
            </div>
        {{?}}

        {{? !it.en.is_separator }}
            <div class="engine-opt-background_tab opt-group">
                <p class="opt-title" data-i18n="engine_opt_background"></p>
                <label class="opt-check">
                    <input type="checkbox" class="background_global" id="engine-opts-background_tab_global-{{=it.id}}"/>
                    <span data-i18n="engine_opt_background_global"></span>
                </label>
                <div class="opt-group indent">
                    <label class="opt-check">
                        <input type="checkbox" class="background_tab" id="engine-opts-background_tab-{{=it.id}}">
                        <span data-i18n="engine_opt_background_tab"></span>
                    </label>
                </div>
            </div>

            <div class="opt-group">
                <p class="opt-title" data-i18n="engine_opt_open_heading"></p>

                <label class="opt-check">
                    <input class="open_in_incognito" id="engine-opt-open-in-incognito-{{=it.id}}" type="checkbox">
                    <span data-i18n="engine_opt_incognito"></span>
                </label>
                <p class="opt-desc" data-i18n="engine_opt_incognito_desc"></p>

                <label class="opt-check">
                    <input class="open_in_window" id="engine-opt-open-in-window-{{=it.id}}" type="checkbox">
                    <span data-i18n="engine_opt_new_window"></span>
                </label>
                <p class="opt-desc" data-i18n="engine_opt_new_window_desc"></p>

                <label class="opt-check">
                    <input class="open_in_popup" id="engine-opt-open-in-popup-{{=it.id}}" type="checkbox">
                    <span data-i18n="engine_opt_popup_window"></span>
                </label>
                <p class="opt-desc" data-i18n="engine_opt_popup_window_desc"></p>

                <label class="opt-check">
                    <input class="negate_newtab_option" id="engine-opt-negate-newtab-option-{{=it.id}}" type="checkbox">
                    <span data-i18n="engine_opt_negate_newtab"></span>
                </label>
                <p class="opt-desc" data-i18n="engine_opt_negate_newtab_desc"></p>

                {{? it.en.is_submenu }}
                    <p class="opt-desc strong" data-i18n="engine_opt_submenu_url_note"></p>
                {{?}}
            </div>
        {{?}}

        <div class="opt-group">
            <label class="opt-check">
                <input class="nosync" id="engine-opt-sync-{{=it.id}}" type="checkbox" />
                <span data-i18n="engine_opt_sync"></span>
            </label>
        </div>

        {{ if(!it.en.is_separator) { }}
            <div class="opt-group">
                <p class="opt-title" data-i18n="engine_opt_hotkey"></p>
                <div class="opt-hotkey">
                    <input class="hotkey-definition-input" id="engine-opt-hotkey-{{=it.id}}" type="text" data-i18n-placeholder="engine_opt_hotkey_placeholder" />
                    <a href="#" class="clear-hotkey" data-i18n="engine_opt_clear_hotkey"></a>
                </div>
                <p class="opt-desc" data-i18n="engine_opt_hotkey_desc"></p>
            </div>
        {{ } }}
    </div>
</td>
<td>
    <a href="#" class="add-inline" data-i18n-title="add_inline_title">+</a>

    <div class="add-inline-popup dropdown-popup">
        <div class="add-inline-content">
            <p>
                <button class="add-inline-button add-inline-engine add-before" data-i18n-title="add_before"></button>
                <span data-i18n="add_inline_engine"></span>
                <button class="add-inline-button add-inline-engine add-after" data-i18n-title="add_after"></button>
            </p>
            <p>
                <button class="add-inline-button add-inline-submenu add-before" data-i18n-title="add_before"></button>
                <span data-i18n="add_inline_submenu"></span>
                <button class="add-inline-button add-inline-submenu add-after" data-i18n-title="add_after"></button>
            </p>
            <p>
                <button class="add-inline-button add-inline-separator add-before" data-i18n-title="add_before"></button>
                <span data-i18n="add_inline_separator"></span>
                <button class="add-inline-button add-inline-separator add-after" data-i18n-title="add_after"></button>
            </p>
        </div>
    </div>

</td>
<td>
    <a href="#" class="delete" data-i18n-title="delete">&times;</a>
</td>
